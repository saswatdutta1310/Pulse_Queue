# PulseQueue Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── PostgreSQL (optional — falls back to SQLite if unavailable) ─
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsequeue

# Or provide a full DATABASE_URL to override the above:
# DATABASE_URL=postgresql://user:pass@host:5432/pulsequeue

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=pulsequeue-python-fastapi-jwt-secret-2026
